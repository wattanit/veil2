{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veil2",
  "version": "2.1.0",
  "identifier": "com.veil2.app",
  "build": {
    "frontendDist": "ui/dist",
    "beforeDevCommand": { "script": "npm run build", "cwd": "ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "ui" }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "shortDescription": "An encrypted vault for macOS.",
    "longDescription": "Veil2 stores files in an encrypted vault, browsable as a list rather than a single block to decrypt. Built for and run on macOS (Requirements §2.1); Windows and Linux are not built, not scheduled, and not claimed.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["veil"],
        "name": "Veil2 Vault",
        "role": "Editor",
        "exportedType": {
          "identifier": "com.veil2.app.vault",
          "conformsTo": ["com.apple.package"]
        }
      }
    ],
    "macOS": {
      "hardenedRuntime": true
    }
  }
}
